# Stellar Network Configuration
REACT_APP_STELLAR_NETWORK=mainnet
REACT_APP_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
REACT_APP_HORIZON_URL=https://horizon.stellar.org

# Contract IDs
REACT_APP_STAKING_CONTRACT_ID=
REACT_APP_SHARED_CONTRACT_ID=
REACT_APP_REWARDS_CONTRACT_ID=
REACT_APP_GOVERNANCE_CONTRACT_ID=
REACT_APP_LIQUIDITY_CONTRACT_ID=

# AQUA Token Configuration
# AQUA Issuer
REACT_APP_AQUA_ISSUER=
# AQUA SAC
REACT_APP_AQUA_TOKEN_CONTRACT=

# BLUB Token Configuration
# BLUB is minted by the staking contract (Soroban)
REACT_APP_BLUB_TOKEN_CONTRACT=
# BLUB Issuer for classic Stellar operations
# Set this to the mainnet BLUB issuer address
REACT_APP_BLUB_ISSUER=

# Admin Account
REACT_APP_ADMIN_ADDRESS=

# Leveraged LP Farming (Blend, testnet) — see docs/technical/leveraged-lp-farming.md
# Leave blank to disable the feature in the app.
REACT_APP_LEVERAGE_VAULT_CONTRACT_ID=
REACT_APP_BLEND_POOL_ID=
REACT_APP_LEVERAGE_AMM_POOL_ID=
REACT_APP_LEVERAGE_LP_TOKEN=
REACT_APP_LEVERAGE_BORROW_ASSET=
REACT_APP_LEVERAGE_PAIR_TOKEN=

# Backend API Configuration
REACT_APP_BACKEND_URL=http://localhost:3001
REACT_APP_BACKEND_API_URL=http://localhost:3001

# Feature Flags
REACT_APP_USE_SOROBAN=true
REACT_APP_ENABLE_CONTRACT_SIMULATION=false
REACT_APP_ENABLE_REAL_TIME_SYNC=true
REACT_APP_DEBUG_MODE=false
