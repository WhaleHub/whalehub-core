{
  "name": "blub-market-maker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone SDEX market-making bot for the BLUB/AQUA pair (WhaleHub). Read the README before running.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/smoke.integration.test.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "12.2.0",
    "dotenv": "^16.4.5",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
