# ── BLUB/AQUA SDEX Market-Making Bot — configuration ──────────────────────────
# Copy to `.env` and edit. Everything has a safe default; DRY_RUN starts true.

# Safety: true = compute & log intended offers but place NOTHING.
# Fail-safe: only an explicit false/0/no/off goes live. Empty, unset or an
# unrecognised value stays in dry run.
DRY_RUN=true

# Required ONLY when DRY_RUN=false. Stellar secret (S...) of the bot's own wallet.
# NEVER commit this. Prefer a secret manager over a plaintext .env in production.
# BOT_SECRET=S................................................

# Network / endpoints
HORIZON_URL=https://horizon.stellar.org
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_NETWORK=public

# ── Quoting ───────────────────────────────────────────────────────────────────
HALF_SPREAD_BPS=50          # half-spread each side of mid (50 = 0.50%)
ORDER_SIZE_BLUB=10000       # BLUB per ladder level
LADDER_LEVELS=3             # number of offers per side
LEVEL_STEP_BPS=40           # price spacing between ladder levels
SIZE_DECAY=1.0              # per-level size multiplier (1.0 = flat)

# ── Inventory skew (mean-revert toward a target inventory mix) ────────────────
TARGET_BLUB_FRACTION=0.5    # target share of portfolio value held in BLUB
SKEW_FACTOR=1.0             # how hard to skew quotes toward the target
MAX_SKEW_BPS=150            # cap on the skew shift

# ── Churn suppression (don't pay fees to nudge offers on tiny moves) ──────────
MIN_REPRICE_BPS=20
MIN_RESIZE_PCT=0.10

# ── Exposure & price sanity bounds ────────────────────────────────────────────
MAX_EXPOSURE_BLUB=100000    # cap total BLUB across ask ladder
MAX_EXPOSURE_AQUA=100000    # cap total AQUA locked across bid ladder
PRICE_FLOOR=0.30            # never quote below this (AQUA per BLUB)
PRICE_CEILING=1.00          # never quote above this
PEG_CEILING=1.00            # hard cap on asks, in AQUA (a risk limit, not a peg)

# ── Reference / fair-mid engine ───────────────────────────────────────────────
REF_QUOTE_SIZE_BLUB=100000  # representative size for the executable pool price
REF_DIVERGENCE_BPS=300      # warn if pool math vs amm-api disagree beyond this
MAX_REFERENCE_AGE_MS=60000  # stale reference beyond this → circuit breaker
SDEX_BLEND_WEIGHT=0         # weight of SDEX mid in the blend (0 = ignore)
SDEX_MIN_DEPTH_BLUB=50000   # require this SDEX depth before trusting its mid
AMM_API_ENABLED=true        # use Aquarius find-path as a cross-check

# ── Loop / fees / reserves ────────────────────────────────────────────────────
LOOP_INTERVAL_MS=20000
FEE_PER_OP_STROOPS=1000     # classic tx fee per operation
MIN_RESERVE_BUFFER_XLM=5    # keep this much XLM free above the protocol minimum.
                            # Each resting offer costs 0.5 XLM of reserve; new offers
                            # are trimmed once free XLM would drop below this.

# ── Misc ──────────────────────────────────────────────────────────────────────
USE_PASSIVE_ASK=false
KILL_SWITCH_FILE=./STOP     # create this file to cancel all offers and idle
LOG_LEVEL=info
BREAKER_REARM_CYCLES=2      # healthy cycles required to re-arm after a breaker trip
